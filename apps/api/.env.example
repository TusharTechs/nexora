# ---- NEXORA API configuration ----
# Copy to apps/api/.env and fill in.  Nothing here is required for the test
# suite (it runs fully hermetic); the values below turn on real behaviour.

# Reasoning core. One of these two must be set for real LLM work.
GEMINI_API_KEY=                       # AI Studio key — simplest for local dev
GCP_PROJECT_ID=                       # set this to use Vertex AI instead / as well
GCP_LOCATION=us-central1

NEXORA_LLM_BACKEND=auto               # auto | gemini | vertex
NEXORA_MODEL_T2=gemini-3.5-flash      # reasoning model (compiler, contract, verifier, composer)
NEXORA_IMAGE_MODEL=imagen-4.0-generate-001
NEXORA_AUDIO_MODEL=lyria-002
NEXORA_VIDEO_MODEL=veo-3.0-generate-001
NEXORA_GROUNDED_RESEARCH=1            # web.research via Gemini + Google Search grounding

# Execution surface
EXECUTION_MODE=MOCK                   # MOCK | LIVE | ACME_LABS
NEXORA_REPO=memory                    # memory | firestore
NEXORA_DISPATCHER=local               # local | cloud  (cloud = Cloud Tasks per node)
NEXORA_WORKER_URL=                    # Cloud Run URL of this service (cloud dispatcher)
NEXORA_WORKER_SA=                     # service account email for OIDC-signed tasks

# LIVE mode (real Google Workspace) — OAuth client from Google Cloud console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend origin(s) for CORS (comma-separated). localhost is always allowed.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Optional: real search backend for web.research (otherwise grounded Gemini / mock)
TAVILY_API_KEY=
